# Copy this file to .env and fill in your own values. Never commit .env.
# Every setting is optional; the values shown are the defaults.

# ---- First admin account (created on startup only if there are no users yet) ----
# Or create users from a terminal:  python -m app.cli create-user <name> --role admin
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- Gemini (the agent's brain) ----
# Get a free key at https://aistudio.google.com/apikey
# Leave empty to run in demo mode (canned replies from config/agent.default.json).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.6
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_SECONDS=30
# How many recent messages are sent to Gemini with each request
LLM_MAX_HISTORY_MESSAGES=40
AGENT_TIMEZONE=Asia/Kolkata

# ---- Plivo (phone calls) ----
# From https://console.plivo.com/dashboard/ (Auth ID and Auth Token)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# A voice-enabled Plivo number you own, in international format, e.g. +918000000000
PLIVO_PHONE_NUMBER=
# Public HTTPS URL where Plivo can reach this server (e.g. your ngrok URL), no trailing slash
PUBLIC_BASE_URL=
PLIVO_VOICE=WOMAN
PLIVO_LANGUAGE=en-US
# Silent turns allowed before the agent hangs up
PLIVO_MAX_SILENT_TURNS=2
# Reject webhooks that aren't signed by Plivo. Only disable for local debugging.
PLIVO_VALIDATE_SIGNATURE=true

# ---- Security ----
SESSION_TTL_HOURS=12
# Set to true when serving over HTTPS (production, ngrok) so the cookie is never sent over plain HTTP
COOKIE_SECURE=false
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Interactive API docs at /docs
ENABLE_API_DOCS=true

# ---- Storage ----
# JSON data folder (users, sessions, conversations). Relative paths are inside the project.
DATA_DIR=data
# The agent's default persona, phone phrases and demo replies
AGENT_DEFAULTS_PATH=config/agent.default.json
