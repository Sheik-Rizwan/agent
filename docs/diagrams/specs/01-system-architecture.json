  "cards": [
    {
      "dot": "cyan",
      "title": "Two entry points",
      "items": [
        "Browser UI: cookie session (SameSite=Strict) or Bearer token",
        "Plivo: unauthenticated webhooks, HMAC-SHA256 signature checked per request"
      ]
    },
    {
      "dot": "emerald",
      "title": "Layering",
      "items": [
        "Controllers -> Services -> Repositories wired by FastAPI Depends()",
        "LLMService falls back to keyword demo replies without GEMINI_API_KEY"
      ]
    },
    {
      "dot": "amber",
      "title": "Storage",
      "items": [
        "JsonFile: temp file + fsync + rename, per-file lock, 0600 files",
        "Agent overrides in data/agent.json over config/agent.default.json"
      ]
    }
  ]
